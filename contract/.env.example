# Ethereum Sepolia RPC URL (e.g. Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Treasury address receiving early-exit penalty fees (defaults to deployer if omitted)
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# NOTE: For deployment, use Foundry encrypted keystore (`cast wallet import deployer --interactive`)
# Do NOT store raw private keys in plain text.

