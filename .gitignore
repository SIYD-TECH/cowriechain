# Monorepo Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
.next/
*/.next/
**/.next/
out/
*/out/
**/out/
build/
dist/

# Vercel
.vercel/
*/.vercel/
**/.vercel/

# Environment Files & Secrets (NEVER commit secrets or private keys)
.env
.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample
*.pem
*.key
*.keystore

# Specific Workspace Secrets
contract/.env
frontend/.env.local

# Foundry & Smart Contract Artifacts
cache/
*/cache/
**/cache/
contract/out/
broadcast/
*/broadcast/
**/broadcast/
foundry.lock

# Testing & Coverage
coverage/
*/coverage/
**/coverage/
*.lcov

# Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak
